#pragma kernel DepthToXYZ

Texture2D<float>  DepthTexture;   // R16 normalised, multiply by 65535 for raw mm
Texture2D<float4> ColorTexture;

// float4 stride=16 avoids Vulkan SPIR-V std430 vec3 alignment corruption.
// w: 1.0 = valid point, 0.0 = invalid/discard.
RWStructuredBuffer<float4> VertexBuffer;
RWStructuredBuffer<float4> ColorBuffer;

// Camera intrinsics (set once from camera_info)
float invFx;       // 1 / fx
float invFy;       // 1 / fy
float cx_over_fx;  // cx / fx
float cy_over_fy;  // cy / fy

float depthScale;   // mm to metres (0.001)
float minDepth;
float maxDepth;
int   width;
int   height;
int   colorWidth;
int   colorHeight;
float colorScaleX;  // colorWidth  / (float)width
float colorScaleY;  // colorHeight / (float)height

// int not bool -- HLSL bool cbuffer is silently zeroed by the HLSL-to-SPIR-V compiler.
int flipYZ;         // 1 = negate Y (ROS Y-down to Unity Y-up)
int flipBGR;        // 1 = swap R/B channels
int flipDepthTexY;  // 1 = flip depth texture read row (corrects depth/colour Y inversion)

// 16x16 thread groups, one thread per pixel. Dispatched as ceil(w/16) x ceil(h/16) groups.
[numthreads(16, 16, 1)]
void DepthToXYZ(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)width || id.y >= (uint)height)
        return;

    int index = id.y * width + id.x;

    // R16 normalised [0,1] to uint16 mm value.
    // flipDepthTexY remaps only the fetch row; back-projection always uses id.y.
    int   depthRow = (flipDepthTexY != 0) ? (height - 1 - (int)id.y) : (int)id.y;
    float depthMM  = DepthTexture[int2(id.x, depthRow)] * 65535.0;
    float depthM   = depthMM * depthScale;

    if (depthMM == 0.0 || depthM < minDepth || depthM > maxDepth)
    {
        VertexBuffer[index] = float4(0, 0, 0, 0);
        ColorBuffer[index]  = float4(0, 0, 0, 0);
        return;
    }

    // Pinhole back-projection.
    // Forward model:
    //   u = fx * (X / Z) + cx
    //   v = fy * (Y / Z) + cy
    // Rearranged to recover X, Y from pixel (u, v) and measured depth Z:
    //   X = (u - cx) * Z / fx  =  Z * (u/fx - cx/fx)
    //   Y = (v - cy) * Z / fy  =  Z * (v/fy - cy/fy)
    float x = depthM * ((float)id.x * invFx - cx_over_fx);
    float y = depthM * ((float)id.y * invFy - cy_over_fy);
    float z = depthM;

    VertexBuffer[index] = (flipYZ != 0)
        ? float4(x, -y, z, 1.0)
        : float4(x,  y, z, 1.0);

    int2   colorPixel = int2((int)((float)id.x * colorScaleX),
                             (int)((float)id.y * colorScaleY));
    float4 col        = ColorTexture[colorPixel];
    float3 rgb        = (flipBGR != 0)
        ? float3(col.b, col.g, col.r)
        : float3(col.r, col.g, col.b);

    ColorBuffer[index] = float4(rgb, 1.0);
}
